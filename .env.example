# Local development defaults. Copy this file to .env before starting Docker.
DJANGO_SECRET_KEY=change-me-before-public-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=youtube_sys
POSTGRES_USER=youtube_sys
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Default values are copied to Global Settings on first use when that setting is absent.
SERPAPI_API_KEY=1f7a3e124afe7780e438febc67219ae9832b56b941f65f7a4e5654ee4bb9b867
YOUTUBE_API_KEY=AIzaSyCS5cnapEBAWmrkKHJMrYx-1d94xPZbOSU
SERPAPI_QPS=1
SERPAPI_MAX_RETRIES=2
# AI 用于打分模型 2.0 的博彩意图筛选（moretokens OpenAI 兼容中转，强制 stream:true）
AI_BASE_URL=https://moretokens.ai/v1
AI_API_KEY=sk-7yzVIRG2dd9Y37KBgq7U95wokHiW2bQVj9t8TD9NX3PvOWlX
AI_MODEL=gemini-3.8-flash-high
# 文案 Agent 可选模型清单（逗号分隔）。在此新增模型，内容生成 Agent 管理的模型下拉会自动出现该选项。
AI_MODELS=gemini-3.8-flash-high,claude-opus-4-8
# 按模型指定专属 Key 的映射（JSON）。未列出的模型回退 AI_API_KEY。Claude 用独立 Key。
AI_MODEL_KEYS={"claude-opus-4-8":"sk-rL5itiYjPi7h4ZQzv7YY1Xwzj7sihACDLAf8C9BZpyDaH20Y"}

# ===== 内容生成系统（流程3）相关 =====
# 生图（封面/模糊底图/尾图）。留空则自动回退用上面的 AI_API_KEY。
GEMINI_IMAGE_API_KEY=sk-7yzVIRG2dd9Y37KBgq7U95wokHiW2bQVj9t8TD9NX3PvOWlX
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 旁白 TTS。不配 ElevenLabs 则默认走免费的 edge-tts。
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# TTS 音色（edge-tts 的 voice 名，留空用内置默认印式英语音色）
FLOW3_TTS_VOICE=
# Remotion 渲染服务地址（docker 内网，一般不用改）
FLOW3_RENDER_URL=http://render:3000/render

