# ===== Uploader Agent 配置 =====
# 后端地址（Docker 后端对宿主暴露在 127.0.0.1:8000）
BACKEND_BASE=http://127.0.0.1:8000
# 执行器回调鉴权 token（需与后端全局设置 UPLOADER_AGENT_TOKEN 一致；留空则不校验）
AGENT_TOKEN=

# 宿主机执行器使用本机回环地址；Docker 后端则使用 host.docker.internal（见后端全局设置 ADSPOWER_API_BASE）
ADSPOWER_API_BASE=http://127.0.0.1:50325
# Docker 集成模式由 Compose 自动配置；若本机直接运行，保持为空。
CDP_HOST_REWRITE=

# 轮询间隔（秒）
POLL_INTERVAL=10
# 开发阶段：True=只存草稿不发布（强烈建议保持 True）
DRAFT_ONLY=True
# 浏览器无头模式（接管 AdsPower 真实浏览器，必须 False）
HEADLESS=False
# 本地临时文件目录（下载视频/封面、存截图）
WORK_DIR=./_work
